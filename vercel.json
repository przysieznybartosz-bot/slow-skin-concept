{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/polityka-prywatnosci",
      "destination": "/index.html"
    },
    {
      "source": "/prywatnosc",
      "destination": "/index.html"
    },
    {
