    },
    {
      "source": "/artykuly/acne-microbiome",
      "destination": "/artykuly/art-acne-microbiome.html"
    },
    {
      "source": "/artykuly/art-couperose-rosacea",
      "destination": "/artykuly/art-couperose-rosacea.html"
    },
    {
      "source": "/artykuly/couperose-rosacea",
      "destination": "/artykuly/art-couperose-rosacea.html"
    },
    {
      "source": "/artykuly/art-hyperpigmentation-melasma",
      "destination": "/artykuly/art-hyperpigmentation-melasma.html"
    },
    {
      "source": "/artykuly/hyperpigmentation-melasma",
      "destination": "/artykuly/art-hyperpigmentation-melasma.html"
    },
    {
      "source": "/((?!api/|.*\\.(?:xml|txt|png|jpg|jpeg|svg|webp|ico|mp4|json|html|js|css)(?:\\?.*)?$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:html|json)|index\\.html|/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|webp|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
