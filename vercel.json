    },
    {
      "source": "/regulamin",
      "destination": "/index.html"
    },
    {
      "source": "/regulamin-gabinetu",
      "destination": "/index.html"
    },
    {
      "source": "/polityka-cookies",
      "destination": "/index.html"
    },
    {
      "source": "/konto",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/artykuly/art-slow-skin-philosophy",
      "destination": "/artykuly/art-slow-skin-philosophy.html"
    },
    {
      "source": "/artykuly/slow-skin-philosophy",
      "destination": "/artykuly/art-slow-skin-philosophy.html"
    },
    {
      "source": "/artykuly/art-neurobiology-skin",
      "destination": "/artykuly/art-neurobiology-skin.html"
    },
    {
      "source": "/artykuly/neurobiology-skin",
      "destination": "/artykuly/art-neurobiology-skin.html"
    },
    {
      "source": "/artykuly/art-hydrolipid-barrier",
      "destination": "/artykuly/art-hydrolipid-barrier.html"
    },
    {
      "source": "/artykuly/hydrolipid-barrier",
      "destination": "/artykuly/art-hydrolipid-barrier.html"
    },
    {
      "source": "/artykuly/art-dryness-deep-hydration",
      "destination": "/artykuly/art-dryness-deep-hydration.html"
    },
    {
      "source": "/artykuly/dryness-deep-hydration",
      "destination": "/artykuly/art-dryness-deep-hydration.html"
    },
    {
      "source": "/artykuly/art-wrinkles-slow-aging",
      "destination": "/artykuly/art-wrinkles-slow-aging.html"
