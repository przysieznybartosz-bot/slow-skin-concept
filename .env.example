# ==============================================================================
# SLOW SKIN CONCEPT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Skonfiguruj poniższe zmienne w środowisku serwerowym (np. panel AI Studio,
# Vercel Project Settings -> Environment Variables lub w prywatnym pliku .env serwera).
# NIGDY nie commituj rzeczywistych sekretów ani tokenów do repozytorium.
# Wszystkie poświadczenia bazy i integracji są przetwarzane WYŁĄCZNIE po stronie serwera.
# Frontend przeglądarki nie ma dostępu do bazy ani kluczy (brak prefiksów VITE_).

# ==============================================================================
# CZĘŚĆ A: ZMIENNE WYMAGANE DO BEZPIECZNEGO DZIAŁANIA I POŁĄCZENIA OAUTH
# ==============================================================================

# 1. Identyfikator klienta OAuth 2.0 (Google Cloud Console dla Slow Skin Concept):
GOOGLE_CLIENT_ID="282678771576-j8q7sbli679o2jkgi2cg5pq9032ikrf4.apps.googleusercontent.com"

# 2. Klucz tajny klienta pasujący do powyższego Client ID:
GOOGLE_CLIENT_SECRET=""

# 3. Adres zwrotny (Redirect URI) zarejestrowany w Google Cloud Console -> Credentials:
# - Środowisko AI Studio (Development):
#   GOOGLE_REDIRECT_URI="https://ais-dev-txeazxhchkgmpieykyn2r4-361970093951.europe-west3.run.app/api/calendar/auth/callback"
# - Środowisko AI Studio (Shared Preview):
#   GOOGLE_REDIRECT_URI="https://ais-pre-txeazxhchkgmpieykyn2r4-361970093951.europe-west3.run.app/api/calendar/auth/callback"
# - Środowisko lokalne (Local Dev):
#   GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/auth/callback"
# - Produkcja Vercel:
#   GOOGLE_REDIRECT_URI="https://slow-skin-concept.pl/api/calendar/auth/callback"
GOOGLE_REDIRECT_URI="https://slow-skin-concept.pl/api/calendar/auth/callback"

# 4. Adres prywatnego projektu Supabase gabinetu Slow Skin (PostgreSQL):
SUPABASE_URL=""

# 5. Klucz service_role Supabase (Backend only - pełny dostęp do bazy z ominięciem RLS):
# Wymagany do zapisu zaszyfrowanych tokenów, stanów PKCE i rezerwacji w tabelach:
# - public.slowskin_google_oauth_tokens
# - public.slowskin_oauth_states
# - public.slowskin_bookings
SUPABASE_SERVICE_ROLE_KEY=""

# 6. Kod PIN logowania personelu do panelu administratora (np. 2026):
# Służy WYŁĄCZNIE jako poświadczenie uwierzytelnienia logowania w panelu.
# Chroniony limitem 5 nieudanych prób w oknie 15 minut i 15-minutową blokadą IP (HTTP 429).
# Nie jest używany do kryptograficznego podpisywania sesji.
ADMIN_PIN=""

# 7. Niezależny, losowy sekret podpisywania sesji administratora i stanów OAuth (HMAC-SHA256):
# WYMÓG BEZPIECZEŃSTWA: Entropia co najmniej 256 bitów (minimum 32 bajty binarne lub 64 znaki hex).
# Wygeneruj poleceniem: openssl rand -hex 32
# Klucz jest całkowicie niezależny od ADMIN_PIN oraz od GOOGLE_CLIENT_SECRET.
ADMIN_JWT_SECRET=""

# 8. Dedykowany 32-bajtowy klucz szyfrowania tokenów OAuth w bazie danych (AES-256-GCM):
# Wygeneruj poleceniem: openssl rand -hex 32
# Niezależny od GOOGLE_CLIENT_SECRET. Zmiana sekretów Google nie unieważnia odczytu tokenów.
TOKEN_ENCRYPTION_KEY=""

# ==============================================================================
# CZĘŚĆ B: ZMIENNE OPCJONALNE (POSIADAJĄ BEZPIECZNE DOMYŚLNE WARTOŚCI W KODZIE)
# ==============================================================================

# 1. Identyfikator docelowego kalendarza gabinetu:
# Jeśli zmienna nie zostanie ustawiona, kod domyślnie używa zweryfikowanego kalendarza gabinetu:
# ec7711f8f95afc5d0e88dd4a404e2b15d3503323b86963b41d25747356d8b0d7@group.calendar.google.com
GOOGLE_CALENDAR_ID="ec7711f8f95afc5d0e88dd4a404e2b15d3503323b86963b41d25747356d8b0d7@group.calendar.google.com"

# 2. Opcjonalne integracje asystenta AI:
GEMINI_API_KEY=""
OPENAI_API_KEY=""
APP_URL="https://slow-skin-concept.pl"
